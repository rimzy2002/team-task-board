# Example environment variable for PowerShell or your local host.
# ASP.NET Core does not load this file automatically.
ASPNETCORE_URLS=http://127.0.0.1:5080
# Set this through .NET user-secrets (ConnectionStrings:TeamTaskBoard)
# or in the shell environment before running EF commands or the API.
ConnectionStrings__TeamTaskBoard=
# Firebase project ID for validating Firebase ID tokens (Firebase:ProjectId in user-secrets).
Firebase__ProjectId=
